# `npx @cmssy/cli link --token cs_...` writes all three into .env.local for you.
# Your organization slug (Settings -> Headless in the cmssy dashboard)
CMSSY_ORG_SLUG=
# Your workspace slug (Settings -> Headless in the cmssy dashboard)
CMSSY_WORKSPACE_SLUG=
# Draft/preview secret, generated per workspace (Settings -> Headless)
CMSSY_DRAFT_SECRET=
# Signing secret of the content.changed webhook pointed at /api/revalidate (Settings -> Webhooks)
CMSSY_WEBHOOK_SECRET=
# Personal API token (workspace owner or site:preview_dev) - dev only. Makes the editor's
# dev host render your dev draft on localhost and lets `pnpm cmssy:sync` push the block manifest.
# `npx @cmssy/cli link --token cs_...` writes it into .env.local.
CMSSY_API_TOKEN=

# Canonical origin for metadata, sitemap and feeds. Falls back to Vercel's production domain.
NEXT_PUBLIC_SITE_URL=
# Google Tag Manager container. Empty = the SevenThreeLabs container hardcoded in components/analytics.tsx.
NEXT_PUBLIC_GTM_ID=
# Direct GA4 tag (G-XXXXXXX), only when GA4 is not configured inside GTM. Empty = none.
# Every Google tag loads with Consent Mode v2 defaults denied (cookieless) until the banner grants consent.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Google Search Console HTML-tag verification token (the content= value), optional.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
